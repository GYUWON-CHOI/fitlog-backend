}

### 제품 목록 조회
GET http://localhost:8080/api/products

### 제품 상세 조회
GET http://localhost:8080/api/products/1

### 아이템 등록
POST http://localhost:8080/api/items
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiIxIiwiaWF0IjoxNzc5OTMxMTUwLCJleHAiOjE3ODAwMTc1NTB9._-GGcRBy7w6yyNnnuHPU-Ubnis9wNdFt6QvhNQhCDMpo39HMMLCAyWto3ph5BGzs

{
  "productId": 1,
  "size": 265,
  "fit": "PERFECT"
}

### 내 아이템 목록 조회
GET http://localhost:8080/api/items
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiIxIiwiaWF0IjoxNzc5OTMxMTUwLCJleHAiOjE3ODAwMTc1NTB9._-GGcRBy7w6yyNnnuHPU-Ubnis9wNdFt6QvhNQhCDMpo39HMMLCAyWto3ph5BGzs

### 아이템 수정
PATCH http://localhost:8080/api/items/1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiIxIiwiaWF0IjoxNzc5OTMxMTUwLCJleHAiOjE3ODAwMTc1NTB9._-GGcRBy7w6yyNnnuHPU-Ubnis9wNdFt6QvhNQhCDMpo39HMMLCAyWto3ph5BGzs

{
  "size": 270,
  "fit": "LOOSE"
}

### 유사도 배치 수동 실행
POST http://localhost:8080/api/admin/batch/similarity
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiIxIiwiaWF0IjoxNzc5OTMxMTUwLCJleHAiOjE3ODAwMTc1NTB9._-GGcRBy7w6yyNnnuHPU-Ubnis9wNdFt6QvhNQhCDMpo39HMMLCAyWto3ph5BGzs

